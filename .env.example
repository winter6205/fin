# fin v1 environment template (T8, #17).
#
# Copy to `.env` and adjust per environment. NEVER commit a real
# `.env` - it is gitignored. The values below are the local
# docker-compose defaults (dev-only credentials) and match
# docker-compose.yml; that match is the spec acceptance gate.

# LLM credentials. ChatOpenAI forwards this as
# `Authorization: Bearer <key>` to official MiniMax Chat
# Completions. Set this in the process environment (local
# shell / Cursor Cloud secret). NEVER paste a real key into a
# chat / commit / log.
#
# Project-owned env-var name (ADR 0022 update 2026-08-27).
# Provider-agnostic. A missing ``FIN_API_KEY`` falls through
# to a placeholder and the provider call returns 401 — a
# loud error signal rather than a silent use of an unexpected
# credential.
FIN_API_KEY=${FIN_API_KEY}

# Postgres connection for the durable checkpointer (ADR 0015).
# Matches the `postgres` service in docker-compose.yml.
FIN_CHECKPOINT_URL=${FIN_CHECKPOINT_URL:-postgresql://fin:fin@localhost:5433/fin?sslmode=disable}

# Chat model for the agent loop. Default is the official
# MiniMax Chat Completions model id (ADR 0022).
FIN_MODEL=${FIN_MODEL:-MiniMax-M3}

# OpenAI-compatible chat-completions endpoint (ADR 0022).
# IMPORTANT: do include /v1 — the official OpenAI SDK appends
# /chat/completions itself. Default is MiniMax CN official:
# POST https://api.minimaxi.com/v1/chat/completions
#
# Overseas: FIN_BASE_URL=https://api.minimax.io/v1
# Local 9router (opt-in): FIN_BASE_URL=http://localhost:20128/v1
# and FIN_MODEL=fin/MiniMax-M3
FIN_BASE_URL=${FIN_BASE_URL:-https://api.minimaxi.com/v1}

# Retrieve adapter behind the retrieve port (ADR 0032).
# `mcp` (the default) is the product path: a stdio MCP 2.0 client
# to the iknow-memory server, launched as `iknow-memory serve`.
# With that binary absent from PATH, `fin-serve` boot logs a
# WARNING and every retrieve call returns retrieve_unavailable.
# `fake` is for default pytest / no-corpus laptop boot only — not
# the authority for real 工作台 use.
FIN_RETRIEVE_ADAPTER=${FIN_RETRIEVE_ADAPTER:-mcp}

# TypeSafe Jev (System One) for host judges (Soft-Track / 档指派).
# Not the MiniMax agent-loop key. Paste a key from
# https://console.typesafe.ai/settings/keys into `.env`.
# Unset → load_jev_config() is None; boot does not fail-start.
# Vendor fallback: TYPESAFE_API_KEY / TYPESAFE_DEFAULT_MODEL /
# TYPESAFE_BASE_URL. Namespaced FIN_JEV_* wins when both are set.
# POST {base}/v1/systemone  Authorization: Bearer <key>
FIN_JEV_API_KEY=${FIN_JEV_API_KEY}
FIN_JEV_MODEL=${FIN_JEV_MODEL:-jev-latest}
FIN_JEV_BASE_URL=${FIN_JEV_BASE_URL:-https://api.typesafe.ai}

# Memory port (ADR 0035 / 0048). Unset = OFF. This checkout
# sets ON so local workspace evals see auto-extract + prefetch.
# Default pytest must stay OFF even when this is true.
FIN_MEMORY_ENABLED=true

# Thread-attachment resource bounds (ADR 0089). All four are required and
# none has a code default: ``fin.host.attachment_budgets.from_environ``
# rejects a missing or non-positive value where it is read rather than
# guessing a cap, because a guessed page limit silently answers from a
# partially read document. ``fin-serve`` reads them before it binds, so an
# unusable bound aborts the boot, and the upload door takes its cap from them.
#
# Measured, not chosen: across the committed corpus the largest file is
# 2,223,272 bytes (72 pages) and the longest is 80 pages (1,861,635 bytes); the
# pinned Docling + Heron + CPU-Tesseract pipeline peaked at 3.10 GiB resident on
# a 72-page conversion; one vision call on a real rendered filing page costs
# ~4.3K input tokens and ~3.1 s, and a crop-sized figure ~1.4K. See
# docs/validation/2026-09-26-g4-t2a-page-vision-budgets.md for the
# extrapolation to 80 pages and the alternative option set. Lower these for a
# smaller device; the run budget must stay >= pages + crop + 1, because one
# reserved full-page transport retry has to fit inside it too.
#
# Two of these four are not measured. The crop count is arithmetic on the gold
# set (2 chart-bearing pages x 4 labelled values), not observed demand, and
# 89 = 80 + 8 + 1 is a policy allowance: the 80 full-page scans plus the 8 crop
# calls the gold set prices, and exactly one reserved full-page retry for the
# whole run, not one per page. It is not measured demand and not a shipped
# product default; every attempt counts against the run total, including
# failed ones. The running service still has 88 until this ships.
FIN_ATTACHMENT_MAX_BYTES=4194304
FIN_ATTACHMENT_MAX_PDF_PAGES=80
FIN_ATTACHMENT_VISION_CALLS_PER_RUN=89
FIN_ATTACHMENT_VISION_CROP_CALLS_PER_RUN=8

# Heron page-region lane (fin.host.attachment_layout.HeronLayoutConfig). All
# six are optional: an unset key takes the shipped default named below, while
# a malformed value fails boot, because a typo in a bound must not silently
# become a different bound. The page lane serves documents either way — with
# no harness image configured the pass reports its own named state and the
# pages keep native text, rendering, OCR, and the vision scan without Heron
# boxes (regions are additive metadata).
# The pinned pipeline harness; default: scripts/g4_pipeline/run_measured.sh in
# the checkout this package was installed from (FIN_ATTACHMENT_HERON_STAGING_DIR
# follows it). Must be an absolute path when set.
#FIN_ATTACHMENT_HERON_SCRIPT=/path/to/fin/scripts/g4_pipeline/run_measured.sh
# Where a document is copied for the container mount; default: the .fin-heron-staging
# directory inside the harness checkout above. Must be an absolute path when set.
#FIN_ATTACHMENT_HERON_STAGING_DIR=/path/to/fin/.fin-heron-staging
# Wall-clock cap per whole-document container pass, in unsigned ASCII seconds;
# default 900 (5.5x the slowest committed filing-text run).
FIN_ATTACHMENT_HERON_TIMEOUT_S=900
# The pinned container image the harness runs; default unset: this checkout
# does not carry a second copy of the image pin, the harness declares it.
#FIN_ATTACHMENT_HERON_IMAGE=
# Cached model-artifact directory for the pass; default unset: the harness's
# own artifact set is used. Must be an absolute path when set.
#FIN_ATTACHMENT_HERON_MODEL_CACHE=
# Run the harness's per-page latency slice pass; default false — this lane
# wants regions, not a price.
FIN_ATTACHMENT_HERON_SLICE_PASS=false
