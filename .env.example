# fin v1 environment template (T8, #17).
#
# Copy to `.env` and adjust per environment. NEVER commit a real
# `.env` - it is gitignored. The values below are the local
# docker-compose defaults (dev-only credentials) and match
# docker-compose.yml; that match is the spec acceptance gate.

# LLM credentials. ChatOpenAI forwards this as
# `Authorization: Bearer <key>`; the local 9router proxy
# passes the header through. NEVER paste a real key into a
# chat / commit / log.
ANTHROPIC_AUTH_TOKEN=sk-cp-Q6U78MAJF-77DJUBpsDDoEbMgLl_01mlMNRrgjHRYPdb3OxkWFCIe1FByPQInJZcS3tz9HJuAhkULZzue3qjcu0Y6qSJPXeyjKE-IhyzBc1ggqn6Dz8PYSc

# Postgres connection for the durable checkpointer (ADR 0015).
# Matches the `postgres` service in docker-compose.yml.
FIN_CHECKPOINT_URL=${FIN_CHECKPOINT_URL:-postgresql://fin:fin@localhost:5432/fin?sslmode=disable}

# Chat model for the agent loop. Default model id is
# fin/MiniMax-M3 served by the local OpenAI-compatible
# proxy (ADR 0022).
FIN_MODEL=${FIN_MODEL:-fin/MiniMax-M3}

# OpenAI-compatible chat-completions endpoint (ADR 0022).
# IMPORTANT: do include /v1 — the official OpenAI SDK appends
# /chat/completions itself. With the default below, requests
# go to http://localhost:20128/v1/chat/completions.
#
# WSL2 users: localhost won't reach the Windows-side proxy.
# Use the WSL gateway IP, e.g.:
#   FIN_BASE_URL=http://172.31.128.1:20128/v1
FIN_BASE_URL=${FIN_BASE_URL:-http://localhost:20128/v1}

# Retrieve adapter behind the retrieve port (ADR 0032).
# `mcp` (the default) is the product path: a stdio MCP 2.0 client
# to the iknow-memory server, launched as `iknow-memory serve`.
# With that binary absent from PATH, `fin-serve` boot logs a
# WARNING and every retrieve call returns retrieve_unavailable.
# Set `fake` to boot without a corpus (empty hits, no MCP).
FIN_RETRIEVE_ADAPTER=${FIN_RETRIEVE_ADAPTER:-mcp}
