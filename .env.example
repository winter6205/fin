# fin v1 environment template (T8, #17).
#
# Copy to `.env` and adjust per environment. NEVER commit a real
# `.env` - it is gitignored. The values below are the local
# docker-compose defaults (dev-only credentials) and match
# docker-compose.yml; that match is the spec acceptance gate.

# LLM credentials. ChatAnthropic forwards this as the
# `x-api-key` header; the local 9router proxy passes the
# header through. NEVER paste a real key into a chat / commit /
# log.
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# Postgres connection for the durable checkpointer (ADR 0015).
# Matches the `postgres` service in docker-compose.yml.
FIN_CHECKPOINT_URL=${FIN_CHECKPOINT_URL:-postgresql://fin:fin@localhost:5432/fin?sslmode=disable}

# Chat model for the agent loop. Default model id is
# minimax-cn/MiniMax-M3 served by the local Anthropic-compatible
# proxy (ADR 0013).
FIN_MODEL=${FIN_MODEL:-minimax-cn/MiniMax-M3}

# Anthropic-compatible proxy endpoint (ADR 0013).
# IMPORTANT: do NOT include /v1 — the official Anthropic SDK
# appends /v1/messages itself. So with the default below,
# requests go to http://localhost:20128/v1/messages.
#
# WSL2 users: localhost won't reach the Windows-side proxy.
# Use the WSL gateway IP, e.g.:
#   FIN_BASE_URL=http://172.31.128.1:20128
FIN_BASE_URL=${FIN_BASE_URL:-http://localhost:20128}
