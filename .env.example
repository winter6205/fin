# fin v1 environment template (T8, #17).
#
# Copy to `.env` and adjust per environment. NEVER commit a real
# `.env` - it is gitignored. The values below are the local
# docker-compose defaults (dev-only credentials) and match
# docker-compose.yml; that match is the spec acceptance gate.

# LLM credentials. The proxy forwards Authorization: Bearer
# <key> upstream, so the literal value of ANTHROPIC_API_KEY is
# opaque to fin - it is whatever the operator has set in their
# shell. NEVER paste a real key into a chat / commit / log.
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# Postgres connection for the durable checkpointer (ADR 0015).
# Matches the `postgres` service in docker-compose.yml.
FIN_CHECKPOINT_URL=${FIN_CHECKPOINT_URL:-postgresql://fin:fin@localhost:5432/fin?sslmode=disable}

# Chat model for the agent loop. Default model id is
# minimax-cn/MiniMax-M3 served by the local OpenAI-compatible
# proxy (ADR 0013).
FIN_MODEL=${FIN_MODEL:-minimax-cn/MiniMax-M3}

# OpenAI-compatible chat-completions endpoint (ADR 0013).
# Default is the local v1 dev proxy on port 20128.
FIN_BASE_URL=${FIN_BASE_URL:-http://localhost:20128/v1}
