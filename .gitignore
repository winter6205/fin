data/corpus
data/upstream/
scripts/g4_pipeline/results/

# OS / copy artifacts
.DS_Store
*:Zone.Identifier

# Claude Code: machine-local permission grants (keep .claude/settings.json)
.claude/settings.local.json

# Serena: local overlay and index cache (keep .serena/project.yml)
.serena/cache/
.serena/project.local.yml

# Machine-local debug residue (browser tests, hook artifacts)
.playwright-cli/
.playwright-cli-e2e/
.claude/scratchpad/post-push.*

# Git worktrees live under .claude/worktrees; never track a checkout
.claude/worktrees/
# Cloud start writes these; keep husky pre-commit/pre-push tracked.
.husky/commit-msg
.husky/prepare-commit-msg

# corpus rebuild products (T13, rebuildable via fin.corpus.rebuild)
data/corpus/blocks/

# Ingest runtime state, written beside the corpus by `fin.corpus.index_job`,
# `fin.corpus.pushed_records` and the ingest worker. These record the operator's
# own pushes for the current checkout, so a `git add -A` would commit several
# megabytes of per-run churn straight into the frozen golden dataset directory.
data/corpus/index_jobs.jsonl
data/corpus/pushed_records.jsonl
data/corpus/ingest_worker_journals/

# ablation eval products (T22, rebuildable via `python -m fin.eval.ablation run`;
# carries per-run latency numbers, so committing it would churn every run)
data/eval/
catalog.json.lock

# Worktree-local: tests reuse the main checkout node_modules via a symlink
web/node_modules

# Local git worktrees registered under the repo dir (see .claude/worktrees too)
.worktrees/

# Checkouts the iknow task runner registers beside this repo's own worktrees;
# machine-local scaffolding, never a product artifact.
.iknow/

# Docs local-only (keep on disk). Product SSOT stays tracked:
# docs/CONTEXT.md, docs/adr/, specs/, active plans/, docs/guides/prompt-development.md
docs/wayfinder/
docs/handoff/
docs/archive/
docs/research/
docs/cross-repo/
docs/design-references/
docs/verify/
plans/archive/
docs/guides/knowledge-agent.md

# A session transcript kept beside the docs, not a product artifact. Same
# local-only policy ADR 0090 records for the directories above.
docs/会话备份.txt

# Local operator shims (not product)
.local-bin/
.qoder

# `fin up` runtime state: serve pid file, verdict file and log. Per-checkout,
# never committed.
.fin/

# Documents staged for the pinned layout container: the harness mounts this
# checkout read-only, so a filing from outside it has to be copied in first.
# Those copies are one thread's private filing content, and the repository is
# auto-committed, so the directory is ignored rather than trusted to a cleanup
# path that can fail.
.fin-heron-staging/

# Scratch harnesses written while exercising the launcher's kill/stop paths
# against a live pid. Throwaway by construction — never a product artifact.
.fin-selftest/

# Copies of uploaded attachments, staged so the read-only /worktree mount can
# open them. Thread-private user bytes: this project auto-commits, so a staged
# upload would otherwise land in the repository history.
.fin-heron-staging/
