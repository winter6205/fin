.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Node / JS (workspace prototype frontend)
# `node_modules` carries no trailing slash on purpose. A `node_modules/`
# rule matches only a real directory, so a worktree sharing the main
# checkout's modules through a SYMLINK of that name was not ignored — and
# once such a link got committed (224b1fe / PR #261, pointing at itself)
# every `npm run` in a checkout carrying it died with ELOOP, which is how
# husky's pre-commit came to fail for reasons unrelated to the staged
# change. Matching the bare name covers directory, symlink and
# not-yet-on-disk alike. Safe because no tracked path has a
# `node_modules` component, so nothing under that name needs un-ignoring
# (tests/test_repo_hygiene.py pins both of those halves).
node_modules
.vite/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Secrets and local env
.env
.env.*
!.env.example

# Data / runtime
data/workspace/
*.sqlite
*.sqlite3
.langgraph_api/
.ipynb_checkpoints/
*.log

# OS / copy artifacts
.DS_Store
*:Zone.Identifier

# Claude Code: machine-local permission grants (keep .claude/settings.json)
.claude/settings.local.json

# Serena: local overlay and index cache (keep .serena/project.yml)
.serena/cache/
.serena/project.local.yml

# Machine-local debug residue (browser tests, hook artifacts)
.playwright-cli/
.playwright-cli-e2e/
.claude/scratchpad/post-push.*

# Git worktrees live under .claude/worktrees; never track a checkout
.claude/worktrees/
# Cloud start writes these; keep husky pre-commit/pre-push tracked.
.husky/commit-msg
.husky/prepare-commit-msg

# corpus rebuild products (T13, rebuildable via fin.corpus.rebuild)
data/corpus/blocks/

# ablation eval products (T22, rebuildable via `python -m fin.eval.ablation run`;
# carries per-run latency numbers, so committing it would churn every run)
data/eval/
catalog.json.lock

# Worktree-local: tests reuse the main checkout node_modules via a symlink
web/node_modules

# Local git worktrees registered under the repo dir (see .claude/worktrees too)
.worktrees/

# Docs local-only (keep on disk). Product SSOT stays tracked:
# docs/CONTEXT.md, docs/adr/, specs/, active plans/, docs/guides/prompt-development.md
docs/wayfinder/
docs/handoff/
docs/archive/
docs/research/
docs/cross-repo/
docs/design-references/
docs/verify/
plans/archive/
docs/guides/knowledge-agent.md

# Local operator shims (not product)
.local-bin/
.qoder

# `fin up` runtime state: serve pid file, verdict file and log. Per-checkout,
# never committed.
.fin/

# Scratch harnesses written while exercising the launcher's kill/stop paths
# against a live pid. Throwaway by construction — never a product artifact.
.fin-selftest/
